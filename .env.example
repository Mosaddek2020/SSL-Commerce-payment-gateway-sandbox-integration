APP_NAME="SSL Commerz Payment"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sslcommerz_db
DB_USERNAME=root
DB_PASSWORD=

# ============================================================================
# SSL Commerz Payment Gateway Configuration
# ============================================================================
#
# Get your credentials from: https://developer.sslcommerz.com/
#
# SANDBOX MODE:
# - Set SSLCOMMERZ_SANDBOX=true for testing
# - Use sandbox credentials from SSL Commerz dashboard
# - Test cards: Visa (4111 1111 1111 1111), Master (5500 0000 0000 0004)
#
# LIVE MODE:
# - Set SSLCOMMERZ_SANDBOX=false for production
# - Use live credentials (requires merchant approval)
# - Real transactions will be processed
#
# IMPORTANT SECURITY NOTES:
# - Never commit real credentials to version control
# - Keep store password secret
# - Use different credentials for sandbox and live
# - Rotate credentials regularly
# ============================================================================

# SSL Commerz Store ID (Merchant ID)
# Example for sandbox: testbox123456
SSLCOMMERZ_STORE_ID=your_store_id_here

# SSL Commerz Store Password (Merchant Password)
# Example for sandbox: testbox123@ssl
SSLCOMMERZ_STORE_PASSWORD=your_store_password_here

# Enable sandbox mode (true for testing, false for production)
SSLCOMMERZ_SANDBOX=true

# Default currency (BDT, USD, EUR, GBP, MYR, SGD)
SSLCOMMERZ_CURRENCY=BDT

# EMI (Equated Monthly Installment) option
SSLCOMMERZ_EMI_OPTION=false

# Product profile type (general, physical-goods, non-physical-goods, airline-tickets, travel-vertical)
SSLCOMMERZ_PRODUCT_PROFILE=general

# Enable transaction validation (recommended for security)
SSLCOMMERZ_VALIDATE_TRANSACTIONS=true

# Enable detailed logging
SSLCOMMERZ_LOGGING=true
SSLCOMMERZ_LOG_LEVEL=info

# Callback URLs (optional - auto-generated from routes if not set)
# SSLCOMMERZ_SUCCESS_URL="${APP_URL}/payment/success"
# SSLCOMMERZ_FAIL_URL="${APP_URL}/payment/fail"
# SSLCOMMERZ_CANCEL_URL="${APP_URL}/payment/cancel"
# SSLCOMMERZ_IPN_URL="${APP_URL}/payment/ipn"

# ============================================================================
# End of SSL Commerz Configuration
# ============================================================================


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
